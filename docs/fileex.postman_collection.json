{
  "info": {
    "name": "Fileex API",
    "description": "Complete API collection for Fileex v1.4. Base URL stored in {{baseUrl}} variable. Access token stored in {{accessToken}} variable. Tokens are returned in the response body (not cookies). File IDs and Folder IDs are integers (INT AUTO_INCREMENT); all other entity IDs are strings.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "fileId", "value": "1", "type": "string" },
    { "key": "folderId", "value": "1", "type": "string" },
    { "key": "trashId", "value": "", "type": "string" },
    { "key": "notificationId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "01 — Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Pratik Pandey\",\n  \"email\": \"pratik@example.com\",\n  \"password\": \"SecurePass123!\"\n}" }
          }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json();", "if(r.data && r.data.accessToken) pm.collectionVariables.set('accessToken', r.data.accessToken);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"pratik@example.com\",\n  \"password\": \"SecurePass123!\"\n}" }
          }
        },
        {
          "name": "Refresh Token",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json();", "if(r.data && r.data.accessToken) pm.collectionVariables.set('accessToken', r.data.accessToken);", "if(r.data && r.data.refreshToken) pm.collectionVariables.set('refreshToken', r.data.refreshToken);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth","refresh"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth","logout"] },
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" }
          }
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth","me"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/password", "host": ["{{baseUrl}}"], "path": ["auth","password"] },
            "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"SecurePass123!\",\n  \"newPassword\": \"NewPass456!\"\n}" }
          }
        }
      ]
    },
    {
      "name": "02 — Files",
      "item": [
        {
          "name": "Initiate Upload (Phase 1)",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json();", "if(r.data && r.data.fileId) pm.collectionVariables.set('fileId', r.data.fileId);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/files/upload/initiate", "host": ["{{baseUrl}}"], "path": ["files","upload","initiate"] },
            "body": { "mode": "raw", "raw": "{\n  \"displayName\": \"document.pdf\",\n  \"mimeType\": \"application/pdf\",\n  \"size\": 2048576,\n  \"parentId\": null\n}" }
          }
        },
        {
          "name": "Complete Upload (Phase 2)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/files/upload/complete", "host": ["{{baseUrl}}"], "path": ["files","upload","complete"] },
            "body": { "mode": "raw", "raw": "{\n  \"fileId\": {{fileId}}\n}" }
          }
        },
        {
          "name": "List Files",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/files?parentId=&sortBy=name&sortDir=asc&page=1&limit=50", "host": ["{{baseUrl}}"], "path": ["files"], "query": [{"key":"parentId","value":"","description":"INT or leave empty for root"},{"key":"sortBy","value":"name"},{"key":"sortDir","value":"asc"},{"key":"page","value":"1"},{"key":"limit","value":"50"}] }
          }
        },
        {
          "name": "Get File",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/files/{{fileId}}", "host": ["{{baseUrl}}"], "path": ["files","{{fileId}}"] }
          }
        },
        {
          "name": "Get Download URL",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/files/{{fileId}}/download-url", "host": ["{{baseUrl}}"], "path": ["files","{{fileId}}","download-url"] }
          }
        },
        {
          "name": "Get Preview URL",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/files/{{fileId}}/preview-url", "host": ["{{baseUrl}}"], "path": ["files","{{fileId}}","preview-url"] }
          }
        },
        {
          "name": "Rename File",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/files/{{fileId}}/rename", "host": ["{{baseUrl}}"], "path": ["files","{{fileId}}","rename"] },
            "body": { "mode": "raw", "raw": "{\n  \"displayName\": \"renamed-document.pdf\"\n}" }
          }
        },
        {
          "name": "Move File",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/files/{{fileId}}/move", "host": ["{{baseUrl}}"], "path": ["files","{{fileId}}","move"] },
            "body": { "mode": "raw", "raw": "{\n  \"destinationParentId\": {{folderId}}\n}" }
          }
        },
        {
          "name": "Copy File",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/files/{{fileId}}/copy", "host": ["{{baseUrl}}"], "path": ["files","{{fileId}}","copy"] },
            "body": { "mode": "raw", "raw": "{\n  \"destinationParentId\": null\n}" }
          }
        },
        {
          "name": "Duplicate File",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/files/{{fileId}}/duplicate", "host": ["{{baseUrl}}"], "path": ["files","{{fileId}}","duplicate"] }
          }
        },
        {
          "name": "Delete File (Soft)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/files/{{fileId}}", "host": ["{{baseUrl}}"], "path": ["files","{{fileId}}"] }
          }
        },
        {
          "name": "Toggle Favorite",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/files/{{fileId}}/favorite", "host": ["{{baseUrl}}"], "path": ["files","{{fileId}}","favorite"] }
          }
        },
        {
          "name": "List Favorites",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/files/favorites", "host": ["{{baseUrl}}"], "path": ["files","favorites"] }
          }
        }
      ]
    },
    {
      "name": "03 — Folders",
      "item": [
        {
          "name": "Create Folder",
          "event": [{ "listen": "test", "script": { "exec": ["const r = pm.response.json();", "if(r.data && r.data.id) pm.collectionVariables.set('folderId', r.data.id);"], "type": "text/javascript" } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/folders", "host": ["{{baseUrl}}"], "path": ["folders"] },
            "body": { "mode": "raw", "raw": "{\n  \"displayName\": \"My Projects\",\n  \"parentId\": null\n}" }
          }
        },
        {
          "name": "List Folders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/folders?parentId=&sortBy=name&sortDir=asc", "host": ["{{baseUrl}}"], "path": ["folders"], "query": [{"key":"parentId","value":""},{"key":"sortBy","value":"name"},{"key":"sortDir","value":"asc"}] }
          }
        },
        {
          "name": "Get Folder",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/folders/{{folderId}}", "host": ["{{baseUrl}}"], "path": ["folders","{{folderId}}"] }
          }
        },
        {
          "name": "Get Breadcrumb",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/folders/{{folderId}}/breadcrumb", "host": ["{{baseUrl}}"], "path": ["folders","{{folderId}}","breadcrumb"] }
          }
        },
        {
          "name": "Get Folder Contents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/folders/{{folderId}}/contents?sortBy=name&sortDir=asc&page=1&limit=50", "host": ["{{baseUrl}}"], "path": ["folders","{{folderId}}","contents"], "query": [{"key":"sortBy","value":"name"},{"key":"sortDir","value":"asc"},{"key":"page","value":"1"},{"key":"limit","value":"50"}] }
          }
        },
        {
          "name": "Rename Folder",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/folders/{{folderId}}/rename", "host": ["{{baseUrl}}"], "path": ["folders","{{folderId}}","rename"] },
            "body": { "mode": "raw", "raw": "{\n  \"displayName\": \"Renamed Folder\"\n}" }
          }
        },
        {
          "name": "Move Folder",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/folders/{{folderId}}/move", "host": ["{{baseUrl}}"], "path": ["folders","{{folderId}}","move"] },
            "body": { "mode": "raw", "raw": "{\n  \"destinationParentId\": null\n}" }
          }
        },
        {
          "name": "Copy Folder",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/folders/{{folderId}}/copy", "host": ["{{baseUrl}}"], "path": ["folders","{{folderId}}","copy"] },
            "body": { "mode": "raw", "raw": "{\n  \"destinationParentId\": null\n}" }
          }
        },
        {
          "name": "Delete Folder (Soft)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/folders/{{folderId}}", "host": ["{{baseUrl}}"], "path": ["folders","{{folderId}}"] }
          }
        }
      ]
    },
    {
      "name": "04 — Trash",
      "item": [
