            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/activity?page=1&limit=50", "host": ["{{baseUrl}}"], "path": ["activity"], "query": [{"key":"page","value":"1"},{"key":"limit","value":"50"},{"key":"action","value":"","disabled":true}] }
          }
        }
      ]
    },
