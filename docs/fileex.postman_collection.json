            "url": { "raw": "{{baseUrl}}/trash", "host": ["{{baseUrl}}"], "path": ["trash"] }
          }
        }
      ]
    },
    {
      "name": "05 — Search",
      "item": [
        {
          "name": "Search",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/search?q=document&type=file&sortBy=name&sortDir=asc&page=1&limit=50",
              "host": ["{{baseUrl}}"], "path": ["search"],
              "query": [{"key":"q","value":"document"},{"key":"type","value":"file"},{"key":"mimeCategory","value":"","disabled":true},{"key":"extension","value":"","disabled":true},{"key":"minSize","value":"","disabled":true},{"key":"maxSize","value":"","disabled":true},{"key":"from","value":"","disabled":true},{"key":"to","value":"","disabled":true},{"key":"parentId","value":"","disabled":true},{"key":"sortBy","value":"name"},{"key":"sortDir","value":"asc"},{"key":"page","value":"1"},{"key":"limit","value":"50"}]
            }
          }
        }
      ]
    },
    {
      "name": "06 — Storage",
      "item": [
