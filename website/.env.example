# FileEX Website — Environment Variables
# Copy this file to `.env` and fill in the values.

# ── FileEX Web Application URL ────────────────────────────────────────────────
# URL where the FileEX browser application is running.
# /login and /register are appended automatically.
# Default (dev): http://localhost:5174
# Production:    https://app.fileex.com
VITE_FILEEX_WEB_URL=http://localhost:5174

# ── Download URLs ─────────────────────────────────────────────────────────────
# Leave empty until a production release build exists.
# When set, the Download button activates automatically.
# VITE_DOWNLOAD_URL_WINDOWS=https://github.com/your-org/fileex/releases/download/v1.0.0/FileEX-Setup-1.0.0.exe
# VITE_DOWNLOAD_URL_MAC=
# VITE_DOWNLOAD_URL_LINUX=

# ── Optional social/docs links ─────────────────────────────────────────────────
# VITE_GITHUB_URL=https://github.com/your-org/fileex
# VITE_DOCS_URL=https://docs.fileex.com
