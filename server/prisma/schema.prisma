// =============================================================================
// Prisma Schema — Fileex
// =============================================================================
//
// Models are added chunk by chunk as features are implemented.
// See: docs/DATABASE_DESIGN.md for the full schema specification.
//
// Current models:
//   ✅ User          — Chunk 3.1
//   ✅ RefreshToken  — Chunk 3.2 (auth)
//
// Pending models:
//   ⬜ File          — Chunk 4.1 (unified file + folder table, see DATABASE_DESIGN.md §3.3)
//   ⬜ StorageStats  — Chunk 4.2
//   ⬜ TrashItem     — Chunk 5.1
//   ⬜ ActivityLog   — Chunk 5.2
//   ⬜ Notification  — Chunk 6.1
//   ⬜ UserSettings  — Chunk 6.2
//
// Note: There is NO separate Folder model. Folders are entries in the File
// table with type = FOLDER. See ADR-009 for the rationale.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// User
// See: docs/DATABASE_DESIGN.md §3.1
// =============================================================================
model User {
  id             String   @id @default(cuid())
  name           String   @db.VarChar(100)
  email          String   @unique @db.VarChar(255)
  hashedPassword String
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  refreshTokens  RefreshToken[]
  // storageStats   StorageStats?
  // folders        Folder[]
  // files          File[]
  // notifications  Notification[]
  // settings       UserSettings?
  // activityLogs   ActivityLog[]

  @@map("users")
}

// =============================================================================
// RefreshToken
//
// Stores hashed refresh tokens for the dual-token auth strategy.
// The raw token is returned to the client; only the SHA-256 hash is persisted.
// onDelete: Cascade ensures tokens are cleaned up when a user is deleted.
// See: docs/DATABASE_DESIGN.md §3.2
// =============================================================================
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
