# ============================================================
# FileEX Server — Environment Variables
# ============================================================
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

PORT=3000
NODE_ENV=development

# MySQL — Prisma connection string
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/fileex

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# AWS S3 — object storage for file blobs
# See: src/modules/storage/storage.config.js
# AWS_REGION:            S3 bucket region (e.g. ap-south-1, us-east-1)
# AWS_BUCKET_NAME:       Name of the S3 bucket (e.g. fileex-storage)
# AWS_ACCESS_KEY_ID:     IAM user access key ID
# AWS_SECRET_ACCESS_KEY: IAM user secret access key
#
# For local development, you can substitute a MinIO instance:
#   AWS_REGION=us-east-1
#   AWS_BUCKET_NAME=fileex-local
#   AWS_ACCESS_KEY_ID=minioadmin
#   AWS_SECRET_ACCESS_KEY=minioadmin
#   (plus override the S3Client endpoint in storage.config.js)
AWS_REGION=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Email / SMTP ──────────────────────────────────────────────
# Gmail SMTP Configuration
# Note: You MUST use a Google "App Password" for SMTP_PASS, not your regular password.
# (Requires 2-Step Verification to be enabled on your Google account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="FileEX" <your_email@gmail.com>
EMAIL_VERIFY_EXPIRY_HOURS=24

# Frontend origin (used for generating verification email links)
CLIENT_URL=http://localhost:5174
